{
  "manifest_version": 3,
  "name": "Tarrafa",
  "version": "2.0.0",
  "description": "Detecta vídeo e áudio em qualquer site e baixa para a pasta que você escolher, usando yt-dlp e ffmpeg da sua máquina.",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "cookies",
    "webRequest",
    "webNavigation",
    "nativeMessaging",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "app.html",
    "default_title": "Tarrafa",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Command+Shift+U"
      },
      "description": "Abrir a Tarrafa"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
